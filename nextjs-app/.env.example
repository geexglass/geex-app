NEXT_PUBLIC_SANITY_PROJECT_ID="<paste your project here>" # Required - The ID of your Sanity project
NEXT_PUBLIC_SANITY_DATASET="production" # Required - The dataset of your Sanity project
NEXT_PUBLIC_SANITY_API_VERSION="2024-10-28" # Optional - The API version provided to the Sanity Client
NEXT_PUBLIC_SANITY_STUDIO_URL="http://localhost:3333" # Optional - defaults to http://localhost:3333
NEXT_PUBLIC_APP_URL="http://localhost:3000" # Optional - used in invitation/password reset links
SANITY_API_READ_TOKEN="<paste your token here>" # Required - The read token for your Sanity project

POSTGRES_HOST="localhost:5432" # Required - PostgreSQL host and port
POSTGRES_USER="postgres" # Required - PostgreSQL user
POSTGRES_PASSWORD="postgres" # Required - PostgreSQL password
POSTGRES_DB="postgres" # Required - PostgreSQL database name

BETTER_AUTH_SECRET="replace-with-a-random-secret" # Required - auth secret
BETTER_AUTH_URL="http://localhost:3000" # Required - app base URL for auth callbacks

EMAIL_USER="" # Required for email flows
EMAIL_PASS="" # Required for email flows
